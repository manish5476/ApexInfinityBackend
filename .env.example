# ==============================================================================
# APEX INFINITY — MODULAR MONOLITH BACKEND CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to `.env` in the root of `apex-framework`:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORK
# ------------------------------------------------------------------------------
# Runtime environment: 'development' | 'production' | 'test'
NODE_ENV=development

# HTTP & Socket.IO server port
# Angular frontend default is http://localhost:5000/api
PORT=5000

# ------------------------------------------------------------------------------
# 2. MONGODB DATABASE
# ------------------------------------------------------------------------------
# Primary MongoDB Connection URI (Local or MongoDB Atlas Cluster)
# Note: Both MONGODB_URI and DATABASE are recognized (DATABASE provides backwards compatibility)
MONGODB_URI=mongodb://localhost:27017
# DATABASE=mongodb://localhost:27017

# Primary Database Name
MONGODB_DB_NAME=apex_framework

# Maximum connection pool size for MongoDB driver
MONGODB_MAX_POOL_SIZE=20

# ------------------------------------------------------------------------------
# 3. CACHE & REDIS
# ------------------------------------------------------------------------------
# Enable Redis for distributed caching and Socket.IO multi-instance adapter
# Set to 'true' or 'false'. When false, an efficient in-memory cache is used.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# Secret key used to sign Access Tokens (min 16 characters, 32+ recommended for production)
JWT_SECRET=apex_infinity_jwt_ultra_secure_secret_key_2026_production

# Access Token lifetime (e.g. 15m, 1h, 24h, 90d)
JWT_EXPIRES_IN=1h

# Secret key used to sign Refresh Tokens (min 16 characters)
REFRESH_TOKEN_SECRET=apex_infinity_refresh_token_ultra_secure_secret_2026

# Refresh Token lifetime
REFRESH_TOKEN_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 5. CORS & FRONTEND CLIENTS
# ------------------------------------------------------------------------------
# Primary Frontend URL for emails, password resets, and redirects
FRONTEND_URL=http://localhost:4200

# Allowed CORS Origins (comma-separated list, whitespace-trimmed)
# Includes Angular Admin (4200), Vite / Storefront (3000), Mobile Expo (8081)
CORS_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:8081,https://apex-infinity.vercel.app

# ------------------------------------------------------------------------------
# 6. CLOUDINARY MEDIA STORAGE (PRODUCT IMAGES, AVATARS, ATTACHMENTS)
# ------------------------------------------------------------------------------
# If left empty, fallback in-memory / local storage is used for development
CLOUDINARY_CLOUD_NAME=dltyapjf6
CLOUDINARY_API_KEY=781331243615427
CLOUDINARY_API_SECRET=_3CmAegIn26TPX6oRKzPCrKIDww

# ------------------------------------------------------------------------------
# 7. EMAIL & SMTP SERVICE (NOTIFICATIONS, PASSWORD RESETS, VERIFICATION)
# ------------------------------------------------------------------------------
# If EMAIL_HOST is provided, Nodemailer SMTP transport is used.
# If omitted, LoggerEmailSender queues and logs emails to console for safe local dev.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=manish.nehal.singh@gmail.com
EMAIL_PASSWORD=qtivshydvojvosrt
EMAIL_FROM_NAME=Apex Infinity
EMAIL_FROM_ADDRESS=manish.nehal.singh@gmail.com

# ------------------------------------------------------------------------------
# 8. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
# Logging level: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 9. TRAFFIC CONTROL & RATE LIMITING
# ------------------------------------------------------------------------------
# Rate limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per IP within the window
RATE_LIMIT_MAX_REQUESTS=200

# HTTP Request Timeout in milliseconds (default: 30000 = 30 seconds)
REQUEST_TIMEOUT_MS=30000
